{
    "name": "repositorio-cloudflare",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Repositorio publico de arquivos com GitHub Pages, Cloudflare Worker, D1 e R2 privado.",
    "scripts": {
          "dev": "wrangler dev",
          "deploy": "wrangler deploy",
          "db:local": "wrangler d1 migrations apply repositorio-db --local",
          "db:remote": "wrangler d1 migrations apply repositorio-db --remote",
          "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^5.20260818.1",
          "typescript": "^5.9.2",
          "wrangler": "^4.28.1"
    }
}
